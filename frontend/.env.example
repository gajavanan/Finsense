# FinSense Frontend Public Environment Variables
# In local development: http://localhost:8000
# In production on Vercel: https://YOUR-RENDER-SERVICE.onrender.com
VITE_API_URL=http://localhost:8000

# Firebase Web App Configuration (from Firebase Console -> Project Settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
