# FinSense Backend Environment Variables Example
# Duplicate this file as .env for local development or configure in Render Dashboard for production

# Application Environment (development | production)
APP_ENV=development

# Database Connection URL
# Local SQLite: sqlite:///./finsense.db
# Neon PostgreSQL (Production): postgresql://user:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./finsense.db

# Authentication / JWT
JWT_SECRET_KEY=change-me-to-a-secure-random-32-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend & CORS
# In production, set to your Vercel domain (e.g. https://finsense.vercel.app)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email Delivery (SMTP / Resend)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true

# Optional AI Providers (Advisor)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GROQ_API_KEY=
RESEND_API_KEY=
