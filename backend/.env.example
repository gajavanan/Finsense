# FinSense Backend Environment Variables Example
# Duplicate this file as .env for local development or configure in Render Dashboard for production

# Application Environment (development | production)
APP_ENV=development

# Database Connection URL
# Local SQLite: sqlite:///./finsense.db
# Neon PostgreSQL (Production): postgresql://user:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./finsense.db

# Authentication / JWT
JWT_SECRET_KEY=change-me-to-a-secure-random-32-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend & CORS
# In production, set to your Vercel domain:
FRONTEND_URL=https://finsense-lovat.vercel.app
ALLOWED_ORIGINS=https://finsense-lovat.vercel.app,http://localhost:5173

# Firebase Admin Credentials (for phone number verification on registration)
# In production on Render, configure these environment variables:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional local path to serviceAccountKey.json (for local dev only, do not commit JSON file):
# FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Password Reset Email Delivery (Resend HTTPS API / Local SMTP)
# Note: Registration verification uses Firebase Phone Auth. Email is strictly for password reset.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=FinSense <onboarding@resend.dev>

# Optional Local SMTP Fallback (for password reset in dev only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Optional AI Providers (Advisor)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GROQ_API_KEY=
