DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET_KEY=change-me-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
# Email provider: prefer SMTP (Gmail) for real delivery, else Resend
RESEND_API_KEY=re_...
EMAIL_FROM=FinSense <noreply@finsense.app>
# Real SMTP (Gmail App Password) - REQUIRED for verification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password-16chars
SMTP_FROM=your-email@gmail.com
SMTP_TLS=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
ENV=development
